# Direct API execution only; root Compose uses root .env.
DATABASE_URL=postgresql://hci:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/hci_study
IP_HASH_SALT=REPLACE_WITH_FRESH_RANDOM_HEX
STAGING=true
SESSION_MAX_MINUTES=60
ASSIGNMENT_BIASED_P=0.8
LITERACY_CUT1=5
LITERACY_CUT2=6
RFI_CUT1=-0.33
RFI_CUT2=0.33
# Separate seeder settings:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=hci_study
DB_USER=hci
DB_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
SEED_DATA_DIR=../seed_data
