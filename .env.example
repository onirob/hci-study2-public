# Copy to .env, then generate fresh local secrets (docs/SETUP.md).
# Hexadecimal secrets avoid connection-URI escaping problems.
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
IP_HASH_SALT=REPLACE_WITH_ANOTHER_64_HEX_CHARACTERS
LOCAL_PORT=8080

# Leave these two empty for offline/dashboard-only exploration.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Optional replacement study actions; disabled by default. These are PUBLIC.
VITE_ENABLE_EXTERNAL_ACTIONS=false
VITE_SUPPORT_EMAIL=
VITE_PROLIFIC_COMPLETED_CODE=
VITE_PROLIFIC_ATTENTION_FAILED_CODE=
VITE_PROLIFIC_COMPREHENSION_FAILED_CODE=
VITE_PROLIFIC_PRESCREEN_EXCLUDED_CODE=
VITE_PROLIFIC_REJECTED_CODE=
VITE_PROLIFIC_SESSION_ISSUE_CODE=
