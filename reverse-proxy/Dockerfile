# --- Stage 1: build the frontend with Vite ---
FROM node:22-alpine AS frontend-build

WORKDIR /app

# Copy package files and install deps
COPY hci-study-app/package*.json ./ 
RUN npm ci

# Copy the rest of the frontend source and build
COPY hci-study-app ./ 

# If your app uses VITE_* env vars, set sane defaults here
ARG VITE_API_BASE=/api
ARG VITE_CHAT_BASE=/chat
ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_CHAT_BASE=$VITE_CHAT_BASE

ARG VITE_ALLOW_FAKE_PROLIFIC
ARG VITE_ENABLE_EXTERNAL_ACTIONS
ARG VITE_SUPPORT_EMAIL
ARG VITE_PROLIFIC_COMPLETED_CODE
ARG VITE_PROLIFIC_ATTENTION_FAILED_CODE
ARG VITE_PROLIFIC_COMPREHENSION_FAILED_CODE
ARG VITE_PROLIFIC_PRESCREEN_EXCLUDED_CODE
ARG VITE_PROLIFIC_REJECTED_CODE
ARG VITE_PROLIFIC_SESSION_ISSUE_CODE
ENV VITE_ALLOW_FAKE_PROLIFIC=$VITE_ALLOW_FAKE_PROLIFIC
ENV VITE_ENABLE_EXTERNAL_ACTIONS=$VITE_ENABLE_EXTERNAL_ACTIONS
ENV VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL
ENV VITE_PROLIFIC_COMPLETED_CODE=$VITE_PROLIFIC_COMPLETED_CODE
ENV VITE_PROLIFIC_ATTENTION_FAILED_CODE=$VITE_PROLIFIC_ATTENTION_FAILED_CODE
ENV VITE_PROLIFIC_COMPREHENSION_FAILED_CODE=$VITE_PROLIFIC_COMPREHENSION_FAILED_CODE
ENV VITE_PROLIFIC_PRESCREEN_EXCLUDED_CODE=$VITE_PROLIFIC_PRESCREEN_EXCLUDED_CODE
ENV VITE_PROLIFIC_REJECTED_CODE=$VITE_PROLIFIC_REJECTED_CODE
ENV VITE_PROLIFIC_SESSION_ISSUE_CODE=$VITE_PROLIFIC_SESSION_ISSUE_CODE
RUN npm run build

# --- Stage 2: Caddy serving static files + reverse proxy ---
FROM caddy:2

# Copy your Caddyfile
COPY reverse-proxy/Caddyfile /etc/caddy/Caddyfile

# Copy built frontend to /srv (Caddy will serve this)
COPY --from=frontend-build /app/dist /srv
